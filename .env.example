# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentorai

# ─── Redis / BullMQ async workers ────────────────────────
# Leave blank to disable async workers (jobs run synchronously)
# REDIS_URL=redis://localhost:6379

# ─── Groq API (AI Quiz Generation) ───────────────────────
# Get a free key at https://console.groq.com
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ─── Builder.io (optional, for CMS blocks) ───────────────
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
